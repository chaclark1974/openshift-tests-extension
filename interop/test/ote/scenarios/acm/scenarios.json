{
  "scenarios": [
    {
      "name": "[sig-acm-upgrade] ACM upgrade harness is wired",
      "product": "acm",
      "category": "acm-upgrade",
      "labels": [
        "OPP",
        "SMOKE"
      ],
      "lifecycle": "informing",
      "command": [
        "bash",
        "-c",
        "echo 'acm upgrade harness ok'"
      ],
      "tags": {
        "tier": "0",
        "owner": "interop-qe"
      }
    },
    {
      "name": "[sig-acm-upgrade] ACM subscription targets an upgrade channel",
      "product": "acm",
      "category": "acm-upgrade",
      "labels": [
        "OPP"
      ],
      "lifecycle": "informing",
      "timeout": "30m",
      "include": "platform==\"aws\"",
      "skipIfEnvUnset": [
        "KUBECONFIG"
      ],
      "command": [
        "bash",
        "-c",
        "oc get subscription -n ${ACM_SUBSCRIPTION_NAMESPACE:-open-cluster-management} advanced-cluster-management -o jsonpath='{.spec.channel}'"
      ]
    },
    {
      "name": "[sig-acm-upgrade] MultiClusterHub reports healthy after upgrade",
      "product": "acm",
      "category": "acm-upgrade",
      "labels": [
        "OPP"
      ],
      "lifecycle": "informing",
      "timeout": "30m",
      "include": "platform==\"aws\"",
      "skipIfEnvUnset": [
        "KUBECONFIG"
      ],
      "command": [
        "bash",
        "-c",
        "oc get multiclusterhub -A -o jsonpath='{.items[*].status.phase}' | grep -q Running"
      ]
    },
    {

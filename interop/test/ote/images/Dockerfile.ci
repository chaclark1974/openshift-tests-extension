FROM registry.access.redhat.com/ubi9/go-toolset:1.23 AS builder

# Copy source code
USER 0
WORKDIR /opt/app-root/src
COPY --chown=1001:0 . .

# Build the ote--interop binary
WORKDIR /opt/app-root/src/interop/test/ote
USER 1001

# Build with FIPS exemption (test binary only)
# Disable VCS stamping to avoid git ownership issues in container
RUN GO_COMPLIANCE_POLICY="exempt_all" go build \
    -buildvcs=false \
    -ldflags "-X 'github.com/openshift-eng/openshift-tests-extension/pkg/version.CommitFromGit=container-build' \
              -X 'github.com/openshift-eng/openshift-tests-extension/pkg/version.BuildDate=$(date -u +%Y-%m-%dT%H:%M:%SZ)' \
              -X 'github.com/openshift-eng/openshift-tests-extension/pkg/version.GitTreeState=clean'" \
    -o ote--interop \
    ./cmd/ote--interop/...

# Runtime image
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Install required tools for test execution
RUN microdnf install -y \
    bash \
    gzip \
    tar \
    git \
    && microdnf clean all

# Create home directory for OTE
RUN mkdir -p /home/ote

# Copy the binary to HOME directory (Edo: easier for troubleshooting, no root needed)
COPY --from=builder /opt/app-root/src/interop/test/ote/ote--interop /home/ote/bin/ote--interop

# Copy test-suites directory (runtime test assets)
COPY --from=builder /opt/app-root/src/interop/test/ote/test-suites /home/ote/test-suites

# Set environment variables
ENV PATH="/home/ote/bin:${PATH}"
ENV OTE_TEST_SUITES_DIR=/home/ote/test-suites

# Set working directory
WORKDIR /home/ote

# Entry point - the OTE binary
ENTRYPOINT ["ote--interop"]
